{
  "name": "@abhi1693/medusa-extra-images",
  "version": "0.0.1",
  "description": "Collection and category images selected from native member-product media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhi1693/medusa-extra-images.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "files": [
    ".medusa/server",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js"
    },
    "./service": {
      "types": "./.medusa/server/src/catalog-images/service.d.ts",
      "default": "./.medusa/server/src/catalog-images/service.js"
    },
    "./media": {
      "types": "./.medusa/server/src/catalog-images/media.d.ts",
      "default": "./.medusa/server/src/catalog-images/media.js"
    },
    "./rbac": {
      "types": "./.medusa/server/src/config/catalog-images-access.d.ts",
      "default": "./.medusa/server/src/config/catalog-images-access.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./package.json": "./package.json",
    "./modules/extra-images": {
      "types": "./.medusa/server/src/modules/extra-images/index.d.ts",
      "default": "./.medusa/server/src/modules/extra-images/index.js"
    }
  },
  "scripts": {
    "build": "medusa plugin:build",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "format": "prettier --write src tests scripts *.json *.mts README.md",
    "format:check": "prettier --check src tests scripts *.json *.mts README.md",
    "test:package": "node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@medusajs/framework": "2.22.2",
    "@medusajs/medusa": "2.22.2",
    "@medusajs/admin-sdk": "2.22.2",
    "@medusajs/js-sdk": "2.22.2",
    "@medusajs/ui": "4.2.9",
    "@medusajs/icons": "2.22.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "5.64.2"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.2",
    "@medusajs/framework": "2.22.2",
    "@medusajs/medusa": "2.22.2",
    "@medusajs/admin-sdk": "2.22.2",
    "@medusajs/js-sdk": "2.22.2",
    "@medusajs/ui": "4.2.9",
    "@medusajs/icons": "2.22.2",
    "@medusajs/dashboard": "2.22.2",
    "@tanstack/react-query": "5.64.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "4.1.12",
    "@vitest/coverage-v8": "4.1.12",
    "vite": "7.3.7",
    "@swc/core": "^1.15.0",
    "ts-node": "^10.9.2",
    "jsdom": "30.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "prettier": "3.9.10"
  },
  "overrides": {
    "@medusajs/utils@2.22.2": {
      "@graphql-codegen/core": "6.2.2",
      "@graphql-codegen/typescript": "6.1.2"
    }
  },
  "packageManager": "npm@11.19.0",
  "homepage": "https://github.com/abhi1693/medusa-extra-images#readme",
  "bugs": {
    "url": "https://github.com/abhi1693/medusa-extra-images/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/abhi1693"
  },
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "ecommerce",
    "typescript",
    "medusa-admin",
    "collection-images",
    "category-images",
    "product-media"
  ],
  "publishConfig": {
    "access": "public"
  }
}
